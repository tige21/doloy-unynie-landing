# Caddy: статика + автоматический HTTPS (Let's Encrypt) для DuckDNS.
# Замените ПОДДОМЕН на свой. Установка Caddy: https://caddyserver.com/docs/install
# Положить в /etc/caddy/Caddyfile и `systemctl reload caddy`.

ПОДДОМЕН.duckdns.org {
	root * /var/www/doloy-unynie
	encode zstd gzip
	file_server

	# долгий кэш для хешированных ассетов, свежий HTML
	@assets path /assets/* /fonts/* /media/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
